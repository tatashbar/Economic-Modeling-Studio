          "port": "macroprudential_stance",
          "lag": 1,
          "stub": "neutral macroprudential stance"
        }
      ],
      "checks": [
        "spread and leverage moments match the data",
        "amplification is quantified against the frictionless core"
      ],
      "status": "attached",
      "validation": "unvalidated",
      "code": null,
      "place": {
        "x": 2,
        "y": 6,
        "rot": 0,
        "level": 1
      }
    },
    {
      "id": "ipf-macroprudential",
      "name": "IPF: macroprudential policy",
      "kind": "financial",
      "layer": 2,
      "freq": "Q",
      "summary": "Macroprudential stance (for example LTV or DSTI limits, taxes on domestic lending) that leans against credit booms to limit overborrowing and fire-sale risk.",
      "provides": [
        "macroprudential_stance"
      ],
      "requires": [
        {
          "port": "bank_credit",
          "lag": 1
