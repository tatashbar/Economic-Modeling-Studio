{
  "output_gap": {"unit": "% of potential output", "desc": "Deviation of output from potential"},
  "gdp_growth": {"unit": "% q/q", "desc": "Real GDP growth"},
  "inflation_cpi": {"unit": "% q/q annualized", "desc": "Consumer price inflation"},
  "nominal_exchange_rate": {"unit": "LCU per USD, index", "desc": "Nominal exchange rate; up = depreciation"},
  "real_exchange_rate": {"unit": "index, up = depreciation", "desc": "Real effective exchange rate"},
  "policy_rate": {"unit": "% p.a.", "desc": "Monetary policy interest rate"},
  "foreign_demand": {"unit": "index", "desc": "Trading-partner demand"},
  "foreign_rate": {"unit": "% p.a.", "desc": "Foreign interest rate"},
  "world_inflation": {"unit": "% q/q annualized", "desc": "Foreign / world inflation"},
  "commodity_price": {"unit": "index", "desc": "Relevant commodity price index"},
  "tariff_rate": {"unit": "% ad valorem", "desc": "Average import tariff rate (scenario lever)"},
  "net_exports": {"unit": "contribution to GDP growth, pp", "desc": "Net exports contribution to demand"},
  "exports_volume": {"unit": "index, real", "desc": "Export volume"},
  "imports_volume": {"unit": "index, real", "desc": "Import volume"},
  "terms_of_trade": {"unit": "index", "desc": "Export prices over import prices"},
  "fiscal_impulse": {"unit": "% of GDP", "desc": "Change in the fiscal stance affecting demand"},
  "primary_balance": {"unit": "% of GDP", "desc": "General government primary balance"},
  "gov_debt": {"unit": "% of GDP", "desc": "General government debt"},
  "resource_revenue": {"unit": "% of GDP", "desc": "Government revenue from natural resources"},
  "carbon_revenue": {"unit": "% of GDP", "desc": "Government revenue from carbon pricing"},
  "current_account": {"unit": "% of GDP", "desc": "Current account balance"},
  "net_foreign_assets": {"unit": "% of GDP", "desc": "Net international investment position"},
  "risk_premium": {"unit": "pp", "desc": "Country risk premium over the foreign rate"},
  "credit_spread": {"unit": "pp", "desc": "External finance premium / lending spread"},
  "bank_credit": {"unit": "% of GDP", "desc": "Bank credit to the private sector"},
  "unemployment_rate": {"unit": "% of labor force", "desc": "Unemployment rate"},
  "wage_inflation": {"unit": "% q/q annualized", "desc": "Nominal wage growth"},
  "energy_price": {"unit": "index", "desc": "Domestic energy price incl. carbon cost"},
  "carbon_price": {"unit": "USD per tCO2", "desc": "Carbon price (scenario lever)"},
  "emissions": {"unit": "MtCO2", "desc": "Domestic greenhouse-gas emissions"},
  "climate_damage": {"unit": "% of GDP", "desc": "Output loss from physical climate impacts"},
  "sectoral_output": {"unit": "index by sector", "desc": "Output by sector"},
  "welfare_change": {"unit": "% equivalent variation", "desc": "Household welfare change versus baseline"},
  "poverty_rate": {"unit": "% of population", "desc": "Headcount poverty rate"},
  "gini": {"unit": "index 0-100", "desc": "Income inequality"},
  "fx_intervention": {"unit": "% of GDP, net FX sales positive", "desc": "Sterilized foreign exchange intervention"},
  "fx_reserves": {"unit": "% of GDP", "desc": "Official foreign exchange reserves"},
  "capital_flow_tax": {"unit": "pp, tax-equivalent on capital inflows", "desc": "Capital flow management measure"},
  "macroprudential_stance": {"unit": "index, up = tighter", "desc": "Macroprudential policy stance (for example LTV or DSTI limits)"}
}
